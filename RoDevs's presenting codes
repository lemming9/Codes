-- ServerScript responsible for anchoring/unanchoring the player's root part whenever the dialog starts/ends

-- This server script handles:

-- Anchoring/unanchoring players when cashier dialogue starts/ends.

local m1
local m2

repeat 
	local s, r = pcall(function()
		return require(game.ReplicatedStorage.moduleScripts.bothScripts.remoteEvents)
	end)
	if s then
		print("'remoteEvents' module has properly loaded on server side to handle remote events!")
		m1 = r
	elseif not s then
		warn("'remoteEvents' module has not loaded properly on server side to handle remote events, trying again")
		task.wait()
	end
until m1

repeat 
	local ss, rr = pcall(function()
		return require(game.ReplicatedStorage.moduleScripts.bothScripts.tweenAssets)
	end)
	if ss then
		print("'tweenAssets' module has loaded properly on server side to handle tweens!")
		m2 = rr
	elseif not ss then
		warn("'tweenAssets' module has not loaded properly on server side to handle tweens, trying again")
		task.wait()
	end
until m2

m2.proxPrompt.Triggered:Once(function()
	m1.dialogStart.OnServerEvent:Connect(function(name)
		if m2.proxPrompt.Enabled == true then
			m2.proxPrompt.Enabled = false
		end
		    m2.proxPrompt.Enabled = false
		for _, part in ipairs(game:GetService("Players"):FindFirstChild(name.Name).Character:GetChildren()) do
			if part.Name == "HumanoidRootPart" then
				if part.Anchored == false then
				  part.Anchored = true
				end  
			end
		end
	end)
end)

m1.dialogEnd.OnServerEvent:Connect(function(name)
	task.wait(5.1)
	for _, part in ipairs(game:GetService("Players"):FindFirstChild(name.Name).Character:GetChildren()) do
		if part.Name == "HumanoidRootPart" then
			if part.Anchored == true then
				part.Anchored = false
			end
		end
	end
	if m2.proxPrompt.Enabled == false then
		m2.proxPrompt.Enabled = true
	end
end)

m1.anchorPLR.OnServerEvent:Connect(function(a, well)
	print(well)
	local hrp = a.Character:FindFirstChild("HumanoidRootPart")
	hrp.Anchored = not hrp.Anchored
end)

